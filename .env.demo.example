# PPT Agent Studio local configuration.
# Copy this file to .env and replace the placeholders for services you enable.
# Never commit .env or real credentials.

APP_NAME=PPT Agent Studio
FLASK_CONFIG=development
SERVER_HOST=127.0.0.1
SERVER_PORT=5000
# Leave blank for a fresh random key on each local start. Set a stable,
# high-entropy value through your deployment secret store for public hosting.
SECRET_KEY=
SSO_ENABLED=false

# Application login gate. Set a unique, randomly generated password of at least
# 12 characters before starting the service; never reuse or commit a real password.
DEMO_ACCESS_USERNAME=demo
DEMO_ACCESS_PASSWORD=
DEMO_LOGIN_MAX_ATTEMPTS=5
DEMO_LOGIN_LOCKOUT_SECONDS=300

# --demo is the local all-in-one mode and uses an isolated SQLite ledger in the
# operating-system temp directory.
# Uncomment to choose another SQLite file. Do not point this at a directory.
# DEMO_DATABASE_PATH=C:\Temp\ppt-agent-studio\demo.sqlite3

# MySQL task ledger for normal `python run.py` startup.
# These DB_* values are intentionally ignored by `python run.py --demo`.
DB_TYPE=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ppt_agent_studio
DB_USER=ppt_agent
DB_PASSWORD=replace-with-your-local-database-password
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=10
DB_POOL_RECYCLE=3600
SQLALCHEMY_ECHO=false
LOG_LEVEL_SQLALCHEMY=WARNING

# Qwen (DashScope OpenAI-compatible API)
QWEN_API_KEY=replace-with-your-qwen-api-key
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.7-plus

# DeepSeek public OpenAI-compatible API.
# Leave these blank when the Qwen provider is used exclusively.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# LibreOffice installation root. Windows example shown; adjust for your OS.
# LIBREOFFICE_PATH=C:\Program Files\LibreOffice

# Agent workflow: structured PPTX contract, quality gate, and safe writeback.
TRANSLATION_ARCH_MODE=v2
TRANSLATION_QUALITY_MODE=enforce
TRANSLATION_MEMORY_ENABLED=1
TRANSLATION_AUTO_RECOVER=0
TASK_QUEUE_MAX_CONCURRENT=2
TRANSLATION_PROVIDER_MAX_CONCURRENT=2
PPTX_XML_ENGINE=structured_v2
PPTX_XML_RUNTIME_FALLBACK=0
PPTX_SEMANTIC_QA_MODE=enforce
PPTX_XML_AUTOFIT_POLICY=editable

# Local process cache. Redis is optional for the all-in-one mode.
CACHE_TYPE=simple
REDIS_URL=redis://127.0.0.1:6379/0
