  "behavior": {
    "auth": {
      "login": {
        "endpoint": "auth.login",
        "methods": [
          "GET",
          "POST"
        ],
        "public": true,
        "get_status": 200,
        "failed_post_status": 302,
        "failed_post_location_contains": "/auth/login"
      }
    },
    "ppt": {
      "authenticated_upload": {
        "endpoint": "main.upload_file",
        "rule": "/upload",
        "method": "POST",
        "access": "authenticated",
        "unauthenticated_status": 302,
        "unauthenticated_location_contains": "/auth/login",
        "success_status": 200,
        "success_fields": [
          "code",
          "msg",
          "queue_position",
          "record_id"
        ],
        "task_options": {
          "mode_field": "bilingual_translation",
          "modes": [
            "translation_only",
            "paragraph_up",
            "paragraph_down"
          ],
          "selected_pages_field": "select_page",
          "selected_pages_value": "1,3",
          "selected_pages_parsed": [
            1,
            3
          ],
          "model_field": "model",
          "models": [
            "qwen",
            "deepseek"
          ],
          "text_splitting_field": "enable_text_splitting",
          "uno_conversion_field": "enable_uno_conversion"
        }
      },
      "start": {
        "endpoint": "main.start_translation",
        "rule": "/start_translation",
        "method": "POST",
        "access": "public",
        "missing_file_status": 400,
        "success_status": 200,
        "task_identifier": "task_id",
        "success_fields": [
          "message",
          "status",
          "task_id"
        ],
        "modes": [
          "translation_only",
          "paragraph_up",
          "paragraph_down"
        ],
        "selected_pages_field": "select_page"
      },
      "status": {
        "endpoint": "main.get_simple_task_status",
        "rule": "/task_status/<task_id>",
        "method": "GET",
        "access": "public",
        "missing_status": 404,
        "missing_fields": [
          "error",
          "status"
        ],
        "known_fields": [
          "current_slide",
          "progress",
          "status",
          "total_slides"
        ]
      },
      "download": {
        "endpoint": "main.download_simple_translated_file",
        "rule": "/download/<task_id>",
        "method": "GET",
        "access": "public",
        "missing_status": 404,
        "not_complete_status": 400,
        "success_status": 200,
        "name_prefix": "translated_",
        "mimetype": "application/vnd.openxmlformats-officedocument.presentationml.presentation"
      }
    },
    "pdf": {
      "status": {
        "endpoint": "main.get_pdf_task_status",
        "rule": "/api/pdf_task_status",
        "method": "GET",
        "access": "authenticated",
        "empty_status": 200,
        "empty_fields": [
          "status"
        ]
      },
      "start": {
        "endpoint": "main.start_pdf_translation",
        "rule": "/api/start_pdf_translation",
        "method": "POST",
        "access": "authenticated",
        "missing_fields_status": 400,
        "success_status": 200,
        "task_identifier": "task_id",
        "success_fields": [
          "message",
          "success",
          "task_id"
        ],
        "model_field": "model",
        "models": [
          "qwen",
          "deepseek"
        ],
        "ocr_option_field": "enable_image_ocr",
        "ocr_true_value": "true",
        "ocr_false_value": "false"
      },
      "translate": {
        "endpoint": "main.translate_pdf",
        "rule": "/translate_pdf",
        "method": "POST",
        "access": "authenticated",
        "missing_file_status": 400,
        "success_status": 200,
        "task_identifier": "task_id",
        "success_fields": [
          "message",
          "success",
          "task_id"
        ],
        "model_field": "model",
        "models": [
          "qwen",
          "deepseek"
        ],
        "ocr_option_field": "enable_image_ocr"
      },
      "download": {
        "endpoint": "main.download_translated_pdf",
        "rule": "/download_translated_pdf/<filename>",
        "method": "GET",
        "access": "authenticated",
        "missing_status": 404,
        "success_status": 200,
        "mimetype": "application/vnd.openxmlformats-officedocument.wordprocessingml.document"
      },
      "docx": {
        "name_template": "translated_{source}_{target}_{original_base}.docx",
        "source_case": "lower",
        "target_case": "lower",
        "extension": ".docx"
      }
    }
  }
}
