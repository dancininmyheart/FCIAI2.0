{
  "routes": [
    {"rule": "/", "endpoint": "main.index", "methods": ["GET"]},
    {"rule": "/api/ppt_translation_history", "endpoint": "main.ppt_translation_history", "methods": ["GET"]},
    {"rule": "/api/translations", "endpoint": "main.get_translations", "methods": ["GET"]},
    {"rule": "/auth/change-password", "endpoint": "auth.change_password", "methods": ["POST"]},
    {"rule": "/auth/demo", "endpoint": "auth.demo_login", "methods": ["POST"]},
    {"rule": "/auth/login", "endpoint": "auth.login", "methods": ["GET", "POST"]},
    {"rule": "/auth/logout", "endpoint": "auth.logout", "methods": ["GET"]},
    {"rule": "/auth/register", "endpoint": "auth.register", "methods": ["GET", "POST"]},
    {"rule": "/auth/sso/callback", "endpoint": "sso.sso_callback", "methods": ["GET"]},
    {"rule": "/auth/sso/config", "endpoint": "sso.sso_config", "methods": ["GET"]},
    {"rule": "/auth/sso/dev-callback", "endpoint": "sso.sso_dev_callback", "methods": ["GET"]},
    {"rule": "/auth/sso/dev-test", "endpoint": "sso.sso_dev_test", "methods": ["GET"]},
    {"rule": "/auth/sso/login", "endpoint": "sso.sso_login", "methods": ["GET"]},
    {"rule": "/auth/sso/logout", "endpoint": "sso.sso_logout", "methods": ["GET"]},
    {"rule": "/auth/sso/saml/acs", "endpoint": "sso.saml_acs", "methods": ["POST"]},
    {"rule": "/auth/sso/saml/login", "endpoint": "sso.saml_login", "methods": ["GET"]},
    {"rule": "/auth/sso/status", "endpoint": "sso.sso_status", "methods": ["GET"]},
    {"rule": "/auth/user-info", "endpoint": "auth.user_info", "methods": ["GET"]},
    {"rule": "/dashboard", "endpoint": "main.dashboard", "methods": ["GET"]},
    {"rule": "/delete/<int:record_id>", "endpoint": "main.delete_file", "methods": ["DELETE"]},
    {"rule": "/download/<int:record_id>", "endpoint": "main.download_file", "methods": ["GET"]},
    {"rule": "/download/<task_id>", "endpoint": "main.download_simple_translated_file", "methods": ["GET"]},
    {"rule": "/index", "endpoint": "main.index_page", "methods": ["GET"]},
    {"rule": "/ppt_translate", "endpoint": "main.ppt_translate_simple", "methods": ["POST"]},
    {"rule": "/start_translation", "endpoint": "main.start_translation", "methods": ["POST"]},
    {"rule": "/switch_language", "endpoint": "main.switch_language", "methods": ["POST"]},
    {"rule": "/task_status", "endpoint": "main.get_task_status", "methods": ["GET"]},
    {"rule": "/task_status/<task_id>", "endpoint": "main.get_simple_task_status", "methods": ["GET"]},
    {"rule": "/upload", "endpoint": "main.upload_file", "methods": ["POST"]}
  ],
  "behavior": {
    "auth": {
      "login": {
        "endpoint": "auth.login",
        "methods": ["GET", "POST"],
        "public": true,
        "get_status": 200,
        "failed_post_status": 302,
        "failed_post_location_contains": "/auth/login"
      }
    },
    "ppt": {
      "authenticated_upload": {
        "endpoint": "main.upload_file",
        "rule": "/upload",
        "method": "POST",
        "access": "authenticated",
        "unauthenticated_status": 302,
        "unauthenticated_location_contains": "/auth/login",
        "success_status": 200,
        "success_fields": [
          "bilingual_translation",
          "code",
          "msg",
          "queue_position",
          "record_id"
        ],
        "task_options": {
          "mode_field": "bilingual_translation",
          "modes": ["translation_only", "paragraph_up", "paragraph_down"],
          "selected_pages_field": "select_page",
          "selected_pages_value": "1,3",
          "selected_pages_parsed": [1, 3],
          "model_field": "model",
          "models": ["qwen", "deepseek"],
          "text_splitting_field": "enable_text_splitting",
          "uno_conversion_field": "enable_uno_conversion"
        }
      },
      "start": {
        "endpoint": "main.start_translation",
        "rule": "/start_translation",
        "method": "POST",
        "access": "public",
        "missing_file_status": 400,
        "success_status": 200,
        "task_identifier": "task_id",
        "success_fields": ["message", "status", "task_id"],
        "modes": ["translation_only", "paragraph_up", "paragraph_down"],
        "selected_pages_field": "select_page"
      },
      "status": {
        "endpoint": "main.get_simple_task_status",
        "rule": "/task_status/<task_id>",
        "method": "GET",
        "access": "public",
        "missing_status": 404,
        "missing_fields": ["error", "status"],
        "known_fields": ["current_slide", "progress", "status", "total_slides"]
      },
      "download": {
        "endpoint": "main.download_simple_translated_file",
        "rule": "/download/<task_id>",
        "method": "GET",
        "access": "public",
        "missing_status": 404,
        "not_complete_status": 400,
        "success_status": 200,
        "name_prefix": "translated_",
        "mimetype": "application/vnd.openxmlformats-officedocument.presentationml.presentation"
      }
    }
  }
}
